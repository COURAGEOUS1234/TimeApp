<resources>
    <style name="Label">
        <item name="android:textColor">#FF2A2A</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/share_tech_mono</item>
        <item name="android:letterSpacing">0.2</item>
    </style>
    <style name="ZoneClock">
        <item name="android:textColor">#F2E9DC</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">@font/share_tech_mono</item>
        <item name="android:shadowColor">#FF2A2A</item>
        <item name="android:shadowRadius">10</item>
        <item name="android:format12Hour">h:mm a</item>
        <item name="android:format24Hour">HH:mm</item>
    </style>
</resources>
