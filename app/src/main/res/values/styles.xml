<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/red</item>
    </style>
    <style name="StandbyTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
    <style name="Label">
        <item name="android:textColor">#FF2A2A</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/share_tech_mono</item>
        <item name="android:letterSpacing">0.2</item>
    </style>
</resources>
