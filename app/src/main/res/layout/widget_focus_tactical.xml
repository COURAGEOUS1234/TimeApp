<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="12dp" android:background="@drawable/widget_bg_tactical">
    <TextView android:id="@+id/w_phase" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="▸ FOCUS" android:textColor="#FFB23E" android:textSize="12sp"
        android:fontFamily="@font/share_tech_mono" android:letterSpacing="0.15" />
    <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="40sp" android:textColor="#E6E8DF" android:fontFamily="@font/black_ops_one" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_round" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="ROUND 1 / 4" android:textColor="#8C948A" android:textSize="11sp"
        android:fontFamily="@font/rajdhani_bold" android:letterSpacing="0.1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_toggle" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1.4"
            android:gravity="center" android:text="START" android:textColor="#FFB23E" android:textSize="13sp"
            android:fontFamily="@font/rajdhani_bold" android:letterSpacing="0.15" android:background="@drawable/widget_btn_tactical" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <TextView android:id="@+id/w_skip" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:gravity="center" android:text="SKIP" android:textColor="#8C948A" android:textSize="13sp"
            android:fontFamily="@font/rajdhani_bold" android:letterSpacing="0.15" android:background="@drawable/widget_btn_tactical" />
    </LinearLayout>
</LinearLayout>
