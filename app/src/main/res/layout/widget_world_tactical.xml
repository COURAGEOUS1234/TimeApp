<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg_tactical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="▸ WORLD CLOCK" android:textColor="#FFB23E" android:textSize="11sp"
        android:fontFamily="@font/share_tech_mono" android:letterSpacing="0.15" />
    <LinearLayout android:id="@+id/w_row0" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_city0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="14sp" android:textColor="#FFB23E" android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.08" android:maxLines="1" android:ellipsize="end" />
        <TextClock android:id="@+id/w_tz0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textSize="20sp"
            android:textColor="#E6E8DF" android:fontFamily="@font/black_ops_one" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_city1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="14sp" android:textColor="#E6E8DF" android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.08" android:maxLines="1" android:ellipsize="end" />
        <TextClock android:id="@+id/w_tz1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textSize="20sp"
            android:textColor="#E6E8DF" android:fontFamily="@font/black_ops_one" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_city2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="14sp" android:textColor="#E6E8DF" android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.08" android:maxLines="1" android:ellipsize="end" />
        <TextClock android:id="@+id/w_tz2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textSize="20sp"
            android:textColor="#E6E8DF" android:fontFamily="@font/black_ops_one" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row3" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_city3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="14sp" android:textColor="#E6E8DF" android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.08" android:maxLines="1" android:ellipsize="end" />
        <TextClock android:id="@+id/w_tz3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textSize="20sp"
            android:textColor="#E6E8DF" android:fontFamily="@font/black_ops_one" />
    </LinearLayout>
</LinearLayout>
