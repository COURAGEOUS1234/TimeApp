<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:padding="16dp" android:background="@drawable/widget_bg_tactical">
    <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="▸ LOCAL" android:textColor="#FFB23E" android:textSize="11sp"
        android:fontFamily="@font/share_tech_mono" android:letterSpacing="0.15" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="bottom">
        <TextClock android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textSize="52sp"
            android:textColor="#FFB23E" android:fontFamily="@font/black_ops_one" android:includeFontPadding="false" />
        <TextClock android:id="@+id/w_ampm" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:layout_marginBottom="6dp"
            android:format12Hour="a" android:format24Hour="" android:textSize="15sp"
            android:textColor="#8C948A" android:fontFamily="@font/rajdhani_bold" />
    </LinearLayout>
    <TextClock android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM" android:textAllCaps="true"
        android:textSize="13sp" android:textColor="#E6E8DF" android:fontFamily="@font/rajdhani_bold" android:letterSpacing="0.12" />
    <TextView android:id="@+id/w_alarm" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="NO ALARMS SET" android:textSize="12sp"
        android:textColor="#7FD8E6" android:fontFamily="@font/share_tech_mono" android:letterSpacing="0.1" />
</LinearLayout>
